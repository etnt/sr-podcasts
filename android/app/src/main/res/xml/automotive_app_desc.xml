<?xml version="1.0" encoding="utf-8"?>
<!-- Declares this app as a media app for Android Auto. Without this
     declaration Android Auto does not list the app on the car screen,
     even when a MediaBrowserService is registered in the manifest.
     See https://developer.android.com/training/cars/media/auto -->
<automotiveApp>
    <uses name="media" />
</automotiveApp>
